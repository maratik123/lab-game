# This configuration module's manifest.
#
# This file documents every environment variable the configuration loader
# reads, and only those: a test asserts that this file's key set, the
# loader's actually-consulted key set, and the loader's own declared key
# set are all identical, failing by name in both directions if they ever
# drift apart.
#
# A variable read by something other than the config loader — for
# example the test database DSN a sibling test helper reads to point the
# test suite at an existing Postgres server — does NOT belong here.
# Document it where it is actually consulted instead; adding it here
# breaks the disjointness test above.
#
# Copy this file to .env (gitignored) and fill in real values before
# running the bot.

# The Telegram bot token, from BotFather.
LAB_GAME_BOT_TOKEN=changeme

# The Postgres connection string. Not parsed by the configuration
# loader — the storage package owns DSN parsing.
LAB_GAME_DSN=postgres://user:password@localhost:5432/labgame?sslmode=disable

# The self-hosted telegram-bot-api instance's base URL. Absolute, scheme
# http or https, non-empty host.
LAB_GAME_BOT_API_BASE_URL=http://localhost:8081

# Comma-separated Telegram chat ids the bot is allowed to write to.
# Telegram group ids are negative.
LAB_GAME_ALLOWED_CHAT_IDS=-1001234567890

# The balance YAML file — every game constant, no compiled-in fallback.
LAB_GAME_BALANCE_PATH=config/balance.yaml

# The world-set target: a directory holding one YAML world file per
# world, each decoded and validated by the configuration loader.
LAB_GAME_WORLD_PATH=config/world

# The Telegram client's Bot API transport tuning. Every variable
# below is OPTIONAL: absent means the documented default applies. Present
# means the value is parsed and validated like every other variable.

# Maximum number of attempts one outbound call makes before giving up.
LAB_GAME_TG_RETRY_MAX_ATTEMPTS=3

# The exponential-backoff scale's base delay between attempts.
LAB_GAME_TG_RETRY_BASE_DELAY=500ms

# The exponential-backoff scale's cap.
LAB_GAME_TG_RETRY_MAX_DELAY=30s

# The exponential-backoff scale's growth factor: delay(attempt) grows as
# base * factor^attempt, clamped at the cap above. Must be finite and
# strictly greater than 1.
LAB_GAME_TG_RETRY_FACTOR=2

# How long a single HTTP attempt may run before it is abandoned. The
# caller's own context remains the bound on the whole call.
LAB_GAME_TG_ATTEMPT_TIMEOUT=30s

# Message-delivering calls (send/copy/forward): global ceiling across all
# chats, per-chat steady rate, and per-chat cap over a longer window.
# "<count>/<duration>" or the literal "off" for unbounded.
LAB_GAME_TG_LIMIT_MESSAGE_GLOBAL=30/1s
LAB_GAME_TG_LIMIT_MESSAGE_CHAT_RATE=1/1s
LAB_GAME_TG_LIMIT_MESSAGE_CHAT_CAP=20/1m

# Edit/delete calls: unbounded by default — no published figure supports a
# bound. Same grammar as the message-class keys above.
LAB_GAME_TG_LIMIT_EDIT_GLOBAL=off
LAB_GAME_TG_LIMIT_EDIT_CHAT_RATE=off
LAB_GAME_TG_LIMIT_EDIT_CHAT_CAP=off

# Every other call: unbounded by default. Same grammar as above.
LAB_GAME_TG_LIMIT_OTHER_GLOBAL=off
LAB_GAME_TG_LIMIT_OTHER_CHAT_RATE=off
LAB_GAME_TG_LIMIT_OTHER_CHAT_CAP=off

# The task scheduler's polling, claim-batch and retry tuning.
# Every variable below is OPTIONAL: absent means the documented default
# applies. These are operational tuning, never a balance number — a
# task's game-meaningful delay is set by the mechanic that schedules it,
# from the balance file, never here.

# How often the worker polls for due tasks.
LAB_GAME_SCHEDULER_POLL_INTERVAL=1s

# How many due tasks one discovery statement claims at most.
LAB_GAME_SCHEDULER_CLAIM_LIMIT=32

# The maximum number of attempts a one-shot task makes before it is given
# up on (its row is marked dead).
LAB_GAME_SCHEDULER_RETRY_MAX_ATTEMPTS=5

# The exponential-backoff scale's base delay between attempts.
LAB_GAME_SCHEDULER_RETRY_BASE_DELAY=1s

# The exponential-backoff scale's cap. Also the interval at which an
# undeclared task type's row is retried.
LAB_GAME_SCHEDULER_RETRY_MAX_DELAY=5m

# The exponential-backoff scale's growth factor: delay(attempt) grows as
# base * factor^attempt, clamped at the cap above. Must be finite and
# strictly greater than 1.
LAB_GAME_SCHEDULER_RETRY_FACTOR=2

# The per-task execution deadline: the handler's context timeout and the
# transaction-local statement_timeout / idle_in_transaction_session_timeout.
LAB_GAME_SCHEDULER_TASK_TIMEOUT=30s

# The update-ingest loop's long-poll, batch and retry tuning. Every
# variable below is OPTIONAL: absent means the documented default
# applies. These are operational tuning, never a balance number.

# How often the poll loop cycles, and the whole bound on the retry rate
# against a failing Bot API.
LAB_GAME_INGEST_POLL_INTERVAL=1s

# The long-poll window transmitted on every getUpdates call. Must be a
# whole number of seconds and strictly below LAB_GAME_TG_ATTEMPT_TIMEOUT.
LAB_GAME_INGEST_LONG_POLL_TIMEOUT=25s

# GetUpdatesParams.Limit. The Bot API accepts values between 1 and 100.
LAB_GAME_INGEST_BATCH_LIMIT=100

# The maximum number of attempts one update's handler is given before it
# is given up on.
LAB_GAME_INGEST_RETRY_MAX_ATTEMPTS=5

# The exponential-backoff scale's base delay between attempts.
LAB_GAME_INGEST_RETRY_BASE_DELAY=1s

# The exponential-backoff scale's cap.
LAB_GAME_INGEST_RETRY_MAX_DELAY=8s

# The exponential-backoff scale's growth factor: delay(attempt) grows as
# base * factor^attempt, clamped at the cap above. Must be finite and
# strictly greater than 1.
LAB_GAME_INGEST_RETRY_FACTOR=2

# The health-metrics endpoint and canary probes' tuning. Every variable
# below is OPTIONAL: absent means the documented default applies. These
# are operational tuning, never a balance number.

# The /metrics endpoint's listen address. Defaults to the loopback
# interface only.
LAB_GAME_HEALTH_METRICS_ADDR=127.0.0.1:9095

# The tick cadence driving both canary probes (the own-instance leg and
# the cloud reference leg) on the same schedule.
LAB_GAME_HEALTH_CANARY_INTERVAL=1m

# The cloud reference leg's bot token — a second, separate token from
# LAB_GAME_BOT_TOKEN, used only for the once-a-minute reference getMe
# call. Leave this set to a real, working token to run the cloud leg, or
# set it EMPTY (not deleted — an absent key and a present-but-empty key
# behave identically here) to disable the cloud leg entirely. The
# placeholder below is not a well-formed bot token, so leaving it in
# place refuses the whole canary at construction — own leg included —
# rather than merely failing the cloud probes; a token that is well
# formed but wrong instead builds the leg and fails every probe from the
# first tick. Either way the answer is "replace the value or blank the
# key", never "the cloud API is down".
LAB_GAME_HEALTH_CANARY_CLOUD_TOKEN=changeme

# The cloud reference leg's Bot API base URL. Validated the same way as
# LAB_GAME_BOT_API_BASE_URL. Only consulted while the cloud leg is
# enabled.
LAB_GAME_HEALTH_CANARY_CLOUD_BASE_URL=https://api.telegram.org

# The composition root's own process tuning. Every variable below is
# OPTIONAL: absent means the documented default applies. These are
# operational tuning, never a balance number.

# Whether pending migrations are applied automatically at start-up. Set
# to false for an operator who applies migrations out of band; with it
# false and a migration pending, the process refuses to start.
LAB_GAME_PROCESS_MIGRATE_ON_START=true

# The whole graceful-shutdown deadline: one bound on the entire drain,
# not a per-subsystem budget.
LAB_GAME_PROCESS_SHUTDOWN_TIMEOUT=30s

# How often the persisted liveness instant is refreshed while the
# process runs.
LAB_GAME_PROCESS_LIVENESS_INTERVAL=30s

# The downtime gap, measured against the persisted liveness instant,
# above which the restart-hygiene shift moves every overdue pending
# scheduler row's run_at forward by the measured gap.
LAB_GAME_PROCESS_DOWNTIME_THRESHOLD=5m
